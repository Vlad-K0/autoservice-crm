<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.autoservice</groupId>
        <artifactId>crm-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>crm-api</artifactId>
    <name>crm-api</name>
    <description>Точка сборки: Spring Boot приложение, REST API, security, миграции.</description>

    <dependencies>
        <!-- Доменные модули -->
        <dependency>
            <groupId>com.autoservice</groupId>
            <artifactId>crm-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.autoservice</groupId>
            <artifactId>crm-clients</artifactId>
        </dependency>
        <dependency>
            <groupId>com.autoservice</groupId>
            <artifactId>crm-catalog</artifactId>
        </dependency>
        <dependency>
            <groupId>com.autoservice</groupId>
            <artifactId>crm-inventory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.autoservice</groupId>
            <artifactId>crm-appointments</artifactId>
        </dependency>
        <dependency>
            <groupId>com.autoservice</groupId>
            <artifactId>crm-workorders</artifactId>
        </dependency>
        <dependency>
            <groupId>com.autoservice</groupId>
            <artifactId>crm-billing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.autoservice</groupId>
            <artifactId>crm-documents</artifactId>
        </dependency>
        <dependency>
            <groupId>com.autoservice</groupId>
            <artifactId>crm-notifications</artifactId>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- БД -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Тесты -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
