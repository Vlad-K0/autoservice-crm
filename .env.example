# Шаблон окружения для docker compose и Makefile.
# Скопируйте и при необходимости поменяйте значения:
#   cp .env.example .env
#
# .env НЕ коммитится (строка в .gitignore); .env.example коммитится как документация.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_PORT=5432

# ВАЖНО: POSTGRES_PASSWORD применяется только при ПЕРВОЙ инициализации тома БД.
# Смена пароля при существующем томе не действует — том нужно пересоздать
# (инструкция: docs/development.md, «Пересоздать базу с нуля»).
#
# Backend читает свои настройки из backend/crm-api/src/main/resources/application.yml;
# при запуске их переопределяют переменные окружения SPRING_DATASOURCE_URL,
# SPRING_DATASOURCE_USERNAME, SPRING_DATASOURCE_PASSWORD.
